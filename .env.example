# ==============================================================================
# VIRaTeC Environment Variables Configuration
# Copy this file to .env and adjust values for local development
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5173

# URLs
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# true, false, or comma-separated proxy IP/CIDR (e.g. loopback,uniquelocal,10.0.0.0/8)
TRUST_PROXY=false

# PostgreSQL Database (Local / Docker)
POSTGRES_USER=viratec_user
POSTGRES_PASSWORD=viratec_password
POSTGRES_DB=viratec_db
POSTGRES_PORT=5432
# Serverless (Vercel): point DATABASE_URL at a pooler (PgBouncer, Neon, Supabase) and append
# &pgbouncer=true&connection_limit=1&pool_timeout=20, then set DIRECT_URL to the direct connection
# for migrations. Long-running servers can raise connection_limit (default: CPU cores * 2 + 1).
DATABASE_URL=postgresql://viratec_user:viratec_password@localhost:5432/viratec_db?schema=public
# Optional: defaults to DATABASE_URL
DIRECT_URL=
# Queries slower than this are logged as warnings
SLOW_QUERY_MS=200

# Redis Cache & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=viratec_redis_secret
REDIS_URL=redis://:viratec_redis_secret@localhost:6379

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=viratec_dev_access_secret_super_secure_key_32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=viratec_dev_refresh_secret_super_secure_key_32chars
JWT_REFRESH_TTL=7d

# Two-factor authentication: 32 random bytes in base64, required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it after admins enable 2FA, or their authenticator secrets can no longer be decrypted.
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=VIRaTeC

# Contentful live content (GET /api/v1/content/entries). Same values as in apps/web/.env.local.
# Without them the site shows the content snapshot from the last build.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_LOCALE_EN=en
CONTENTFUL_LOCALE_UK=uk
# Site editor (/api/v1/admin/content). Preview API token and a management token for the API service only.
CONTENTFUL_PREVIEW_TOKEN=
CONTENTFUL_MANAGEMENT_TOKEN=
# Shared secret of the Contentful webhook that refreshes the content cache (POST /api/v1/content/webhook).
CONTENTFUL_WEBHOOK_SECRET=

# Automatic translation in the site editor (POST /api/v1/admin/content/translate), Claude API key.
# Without it the Translate button explains that translation is not set up.
ANTHROPIC_API_KEY=

# Google Sign-In (OAuth Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Transactional email (verification links and password reset codes) sent through the Gmail API.
# Sender is a Gmail account, e.g. coil.knu@gmail.com. Use an OAuth client of type "Web application"
# with the gmail.send scope and a refresh token issued for the sender account (see docs/deployment/email.md).
# Without these values, outside production the emails are written to the API log instead of sent.
MAIL_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# S3 / MinIO Object Storage
MINIO_ROOT_USER=viratec_minio_admin
MINIO_ROOT_PASSWORD=viratec_minio_secret_pass
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=viratec_minio_admin
S3_SECRET_KEY=viratec_minio_secret_pass
S3_BUCKET_DOCS=viratec-docs
S3_BUCKET_MEDIA=viratec-media

# Frontend Environment (Vite)
# For local Vite, copy apps/web/.env.example to apps/web/.env.local.
# These root values are passed to the frontend build by Docker Compose.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_TITLE=VIRaTeC - KNU Research & Technology Community
VITE_GOOGLE_CLIENT_ID=
VITE_SITE_URL=
