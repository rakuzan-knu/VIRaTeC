# ==============================================================================
# VIRaTeC Environment Variables Configuration
# Copy this file to .env and adjust values for local development
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5173

# URLs
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# PostgreSQL Database (Local / Docker)
POSTGRES_USER=viratec_user
POSTGRES_PASSWORD=viratec_password
POSTGRES_DB=viratec_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://viratec_user:viratec_password@localhost:5432/viratec_db?schema=public

# Redis Cache & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=viratec_redis_secret
REDIS_URL=redis://:viratec_redis_secret@localhost:6379

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=viratec_dev_access_secret_super_secure_key_32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=viratec_dev_refresh_secret_super_secure_key_32chars
JWT_REFRESH_TTL=7d

# S3 / MinIO Object Storage
MINIO_ROOT_USER=viratec_minio_admin
MINIO_ROOT_PASSWORD=viratec_minio_secret_pass
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=viratec_minio_admin
S3_SECRET_KEY=viratec_minio_secret_pass
S3_BUCKET_DOCS=viratec-docs
S3_BUCKET_MEDIA=viratec-media

# Frontend Environment (Vite)
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_TITLE=VIRaTeC - KNU Research & Technology Community
