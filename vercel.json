{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile --node-linker=hoisted",
      "buildCommand": "pnpm --filter @viratec/contracts build && pnpm content:pull --fallback && pnpm build",
      "outputDirectory": "dist",
      "routes": [
        {
          "src": "/assets/(.*)",
          "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
          "continue": true
        },
        { "handle": "filesystem" },
        { "src": "/assets/(.*)", "status": 404 },
        { "src": "/(.*)", "dest": "/$1.html", "check": true },
        { "src": "/(.*)", "dest": "/spa.html" }
      ]
    },
    "api": {
      "root": ".",
      "framework": "nestjs",
      "installCommand": "pnpm install --frozen-lockfile --node-linker=hoisted",
      "buildCommand": "pnpm --filter @viratec/backend build && pnpm --filter @viratec/backend db:migrate"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/((?!api/|docs).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https://*.googleusercontent.com https://images.ctfassets.net; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://accounts.google.com; connect-src 'self' https://accounts.google.com; frame-src 'self' https://accounts.google.com"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/docs", "destination": { "service": "api" } },
    { "source": "/docs/(.*)", "destination": { "service": "api" } },
    { "source": "/docs-json", "destination": { "service": "api" } },
    { "source": "/docs-yaml", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
