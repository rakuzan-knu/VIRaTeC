generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  RESEARCHER
  PROFESSOR
  ADMIN
  PARTNER
}

enum StaffRole {
  NONE
  ADMIN
  OWNER
}

enum AdminPermission {
  DASHBOARD_VIEW
  USERS_VIEW
  USERS_MANAGE
  CONTENT_VIEW
  CONTENT_EDIT
  CONTENT_PUBLISH
  EVENTS_MANAGE
  MEDIA_MANAGE
  AUDIT_VIEW
}

enum FacultyDivision {
  FIT
  NNIF
  OTHER
}

enum StudyLevel {
  BACHELOR
  MASTER
  PHD
  FACULTY
  RESEARCHER
  OTHER
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS
  PRIVATE
}

enum SavedItemKind {
  PUBLICATION
  PROJECT
}

enum ProjectStatus {
  IDEA
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum EventType {
  HACKATHON
  CONFERENCE
  WORKSHOP
  SEMINAR
  MEETUP
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String?
  googleId     String?           @unique
  name         String
  role         UserRole          @default(STUDENT)
  faculty      FacultyDivision   @default(FIT)
  department   String?
  bio          String?
  avatarUrl    String?
  skills       String[]          @default([])
  studyLevel   StudyLevel?
  studyYear    Int?
  institution  String?
  country      String?
  languages    Json              @default("[]")
  links        Json              @default("{}")
  openTo       String[]          @default([])
  visibility   ProfileVisibility @default(MEMBERS)
  showEmail    Boolean           @default(false)
  isBlocked    Boolean           @default(false)

  staffRole      StaffRole         @default(NONE)
  permissions    AdminPermission[] @default([])
  staffExpiresAt DateTime?

  twoFactorEnabled       Boolean @default(false)
  twoFactorSecret        String?
  twoFactorPendingSecret String?
  twoFactorLastStep      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  papers        ResearchPaper[]
  projects      Project[]
  posts         CommunityPost[]
  refreshTokens RefreshToken[]
  avatar        UserAvatar?
  savedItems    SavedItem[]
  backupCodes   BackupCode[]
  mfaChallenges MfaChallenge[]
  auditActions  AuditLog[]      @relation("AuditActor")

  @@map("users")
}

model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt

  @@map("user_avatars")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  mfaVerifiedAt DateTime?
  elevatedUntil DateTime?

  @@index([userId, sessionId])
  @@map("refresh_tokens")
}

model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("backup_codes")
}

model MfaChallenge {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  attempts   Int       @default(0)
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("mfa_challenges")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@map("rate_limit_buckets")
}

model SavedItem {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      SavedItemKind
  refId     String
  createdAt DateTime      @default(now())

  @@unique([userId, kind, refId])
  @@map("saved_items")
}

model ResearchPaper {
  id             String          @id @default(uuid())
  title          String
  abstract       String
  authors        String[]
  primaryFaculty FacultyDivision @default(FIT)
  keywords       String[]        @default([])
  doi            String?
  fileUrl        String?
  authorId       String
  author         User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("research_papers")
}

model Project {
  id            String            @id @default(uuid())
  title         String
  description   String
  status        ProjectStatus     @default(IDEA)
  faculties     FacultyDivision[] @default([FIT])
  tags          String[]          @default([])
  repositoryUrl String?
  demoUrl       String?
  leadId        String
  lead          User              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("projects")
}

model Event {
  id               String          @id @default(uuid())
  title            String
  description      String
  type             EventType       @default(WORKSHOP)
  faculty          FacultyDivision @default(FIT)
  location         String
  isOnline         Boolean         @default(false)
  startDate        DateTime
  endDate          DateTime
  capacity         Int?
  registrationLink String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("events")
}

model CommunityPost {
  id         String   @id @default(uuid())
  title      String
  content    String
  tags       String[] @default([])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likesCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("community_posts")
}
