generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  RESEARCHER
  PROFESSOR
  ADMIN
  PARTNER
}

enum StaffRole {
  NONE
  ADMIN
  OWNER
}

enum AdminPermission {
  DASHBOARD_VIEW
  USERS_VIEW
  USERS_MANAGE
  CONTENT_VIEW
  CONTENT_EDIT
  CONTENT_PUBLISH
  EVENTS_MANAGE
  MEDIA_MANAGE
  AUDIT_VIEW
}

enum FacultyDivision {
  FIT
  NNIF
  OTHER
}

enum StudyLevel {
  BACHELOR
  MASTER
  PHD
  FACULTY
  RESEARCHER
  OTHER
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS
  PRIVATE
}

enum SavedItemKind {
  PUBLICATION
  PROJECT
}

enum ProjectStatus {
  IDEA
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum EventType {
  HACKATHON
  CONFERENCE
  WORKSHOP
  SEMINAR
  MEETUP
}

enum PublicationType {
  PAPER
  NEWS
  EVENT
  MEDIA
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String?
  googleId     String?           @unique
  name         String
  role         UserRole          @default(STUDENT)
  faculty      FacultyDivision   @default(FIT)
  department   String?
  bio          String?
  avatarUrl    String?
  skills       String[]          @default([])
  studyLevel   StudyLevel?
  studyYear    Int?
  institution  String?
  country      String?
  languages    Json              @default("[]")
  links        Json              @default("{}")
  openTo       String[]          @default([])
  visibility   ProfileVisibility @default(MEMBERS)
  showEmail    Boolean           @default(false)
  isBlocked    Boolean           @default(false)

  staffRole      StaffRole         @default(NONE)
  permissions    AdminPermission[] @default([])
  staffExpiresAt DateTime?

  twoFactorEnabled       Boolean @default(false)
  twoFactorSecret        String?
  twoFactorPendingSecret String?
  twoFactorLastStep      Int?

  termsAcceptedAt DateTime?
  termsVersion    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  papers        ResearchPaper[]
  projects      Project[]
  posts         CommunityPost[]
  postLikes     PostLike[]
  refreshTokens RefreshToken[]
  avatar        UserAvatar?
  savedItems    SavedItem[]
  backupCodes   BackupCode[]
  mfaChallenges MfaChallenge[]
  auditActions  AuditLog[]      @relation("AuditActor")
  contentEdits  ContentChange[]

  @@index([createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "users_name_trgm_idx", type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], map: "users_email_trgm_idx", type: Gin)
  @@index([institution(ops: raw("gin_trgm_ops"))], map: "users_institution_trgm_idx", type: Gin)
  @@index([department(ops: raw("gin_trgm_ops"))], map: "users_department_trgm_idx", type: Gin)
  @@index([bio(ops: raw("gin_trgm_ops"))], map: "users_bio_trgm_idx", type: Gin)
  @@index([skills], type: Gin)
  @@index([openTo], type: Gin)
  @@map("users")
}

model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt

  @@map("user_avatars")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  mfaVerifiedAt DateTime?
  elevatedUntil DateTime?

  @@index([userId, sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("backup_codes")
}

model MfaChallenge {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  attempts   Int       @default(0)
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

enum ContentResourceType {
  ENTRY
  ASSET
  PROJECT
  EVENT
  PUBLICATION
}

model ContentChange {
  id            String              @id @default(uuid())
  resourceType  ContentResourceType
  resourceId    String
  contentTypeId String?
  label         String?
  isNew         Boolean             @default(false)
  isDeleted     Boolean             @default(false)
  fieldIds      String[]            @default([])
  draft         Json?
  baseUpdatedAt DateTime?
  actorId       String?
  actor         User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([resourceType, resourceId])
  @@index([updatedAt])
  @@map("content_changes")
}

model ContentCacheState {
  id        Int      @id @default(1)
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("content_cache_state")
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model SavedItem {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      SavedItemKind
  refId     String
  createdAt DateTime      @default(now())

  @@unique([userId, kind, refId])
  @@map("saved_items")
}

model ResearchPaper {
  id             String          @id @default(uuid())
  title          String
  abstract       String
  authors        String[]
  primaryFaculty FacultyDivision @default(FIT)
  keywords       String[]        @default([])
  doi            String?
  fileUrl        String?
  authorId       String
  author         User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@map("research_papers")
}

model Project {
  id            String            @id @default(uuid())
  title         String
  description   String
  status        ProjectStatus     @default(IDEA)
  faculties     FacultyDivision[] @default([FIT])
  tags          String[]          @default([])
  repositoryUrl String?
  demoUrl       String?
  coverUrl      String?
  translations  Json?
  leadId        String?
  lead          User?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([leadId])
  @@index([createdAt])
  @@map("projects")
}

model Event {
  id               String          @id @default(uuid())
  title            String
  description      String
  type             EventType       @default(WORKSHOP)
  faculty          FacultyDivision @default(FIT)
  location         String
  isOnline         Boolean         @default(false)
  startDate        DateTime
  endDate          DateTime
  capacity         Int?
  registrationLink String?
  translations     Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([startDate])
  @@index([type])
  @@map("events")
}

model Publication {
  id           String          @id @default(uuid())
  slug         String          @unique
  type         PublicationType
  year         Int
  position     Int
  isFeatured   Boolean         @default(false)
  readMoreLink Boolean         @default(false)
  coverKey     String?
  sourceUrl    String?
  pdfUrl       String?
  detailSource String?
  content      Json
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([position])
  @@map("publications")
}

model CommunityPost {
  id         String     @id @default(uuid())
  title      String
  content    String
  tags       String[]   @default([])
  authorId   String
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likesCount Int        @default(0)
  likes      PostLike[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@map("community_posts")
}

model PostLike {
  id        String        @id @default(uuid())
  userId    String
  postId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@map("post_likes")
}
