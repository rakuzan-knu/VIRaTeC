# Copy to apps/web/.env.local. Vite reads env files from apps/web.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_TITLE=VIRaTeC - KNU Research & Technology Community
# Use the same Web application OAuth Client ID as GOOGLE_CLIENT_ID in the root .env.
VITE_GOOGLE_CLIENT_ID=
# Public site origin for canonical URLs, Open Graph images and sitemap. On Vercel defaults to the production domain.
VITE_SITE_URL=
# Contentful, read only by build-tools/contentful scripts. Never prefix these with VITE_.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
# Content Delivery API token, also set on Vercel for content:pull.
CONTENTFUL_DELIVERY_TOKEN=
# Personal access token (CFPAT-), local only for content:model and content:webhooks. Never add it to Vercel.
CONTENTFUL_MANAGEMENT_TOKEN=
# Contentful locale codes for the app locales en and uk, if they differ.
CONTENTFUL_LOCALE_EN=en
CONTENTFUL_LOCALE_UK=uk
# Vercel deploy hook URLs, local only for content:webhooks. The preview hook is optional.
VERCEL_DEPLOY_HOOK_PRODUCTION=
VERCEL_DEPLOY_HOOK_PREVIEW=
